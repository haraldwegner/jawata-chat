{
  "name": "@jawata/chat-view",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "description": "The chat's view in React: renders the view state chat-core folds and sends intents; knows no host",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test --test-timeout=60000 \"test/**/*.test.mjs\""
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@jawata/chat-core": "*",
    "dompurify": "^3.2.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@jawata/acp-contract": "*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "typescript": "7.0.2"
  }
}
