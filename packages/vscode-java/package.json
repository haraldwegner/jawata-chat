{
  "name": "jawata-java",
  "displayName": "jawata Java",
  "description": "Java language support from the one jawata engine: problems from unsaved text, navigation and completion, without a second Java server",
  "version": "0.1.0",
  "publisher": "jawata",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/haraldwegner/jawata-chat.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "language server",
    "jawata"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "icon": "resources/icon.png",
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jawataJava.showLog",
        "title": "jawata Java: Show Log"
      },
      {
        "command": "jawataJava.restartServer",
        "title": "jawata Java: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "jawata Java",
      "properties": {
        "jawataJava.server": {
          "type": "object",
          "description": "How the editor reaches the jawata engine's language server: the command that runs the launcher with --lsp, its arguments and its environment. The launcher only forwards the editor's messages to the engine that is already running; it starts no language server of its own. Example: command java, args -jar <jawata.jar> --lsp --url <the engine's base address>.",
          "default": {},
          "properties": {
            "command": {
              "type": "string",
              "description": "Program to start"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Command-line arguments, which must include --lsp"
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Environment variables the launcher is started with, added to the editor's own, for example JAWATA_URL and JAWATA_KEY."
            }
          }
        },
        "jawataJava.rivalExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "redhat.java"
          ],
          "description": "Identifiers of other extensions that run a Java language server of their own. If one of them is installed, jawata Java says so, because the editor would then run two Java servers over the same files; switch the other one off for this workspace."
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack",
    "build": "npm run compile",
    "compile-tests": "tsc -p tsconfig.test.json",
    "lint": "eslint src --max-warnings 0",
    "test": "npm run compile-tests && node --test \"test/**/*.test.mjs\"",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vscode:prepublish": "npm run package"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
}
