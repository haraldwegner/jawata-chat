{
  "name": "jawata-chat",
  "displayName": "jawata chat",
  "description": "jawata's own chat for ACP agents",
  "version": "0.2.0",
  "publisher": "jawata",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/haraldwegner/jawata-chat.git"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "acp",
    "agent",
    "jawata"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "icon": "resources/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jawata-chat",
          "title": "jawata chat",
          "icon": "resources/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "jawata-chat-secondary",
          "title": "jawata chat",
          "icon": "resources/icon.svg"
        },
        {
          "id": "jawata-control",
          "title": "Agent Control",
          "icon": "resources/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "jawata-chat-panel",
          "title": "jawata chat",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "jawata-chat": [
        {
          "id": "jawata-chat-view",
          "name": "Chat",
          "type": "webview"
        }
      ],
      "jawata-chat-secondary": [
        {
          "id": "jawata-chat-view-right",
          "name": "Chat",
          "type": "webview",
          "when": "config.jawataChat.placement == 'right'"
        }
      ],
      "jawata-chat-panel": [
        {
          "id": "jawata-chat-view-bottom",
          "name": "Chat",
          "type": "webview",
          "when": "config.jawataChat.placement == 'bottom'"
        }
      ],
      "jawata-control": [
        {
          "id": "jawata-agents-view",
          "name": "Agent Control",
          "type": "webview"
        },
        {
          "id": "jawata-btw-view",
          "name": "btw",
          "type": "webview",
          "when": "jawataChat.btwOpen"
        }
      ]
    },
    "commands": [
      {
        "command": "jawataChat.openSession",
        "title": "jawata chat: Open Session…"
      },
      {
        "command": "jawataChat.connectAgent",
        "title": "jawata chat: Connect to Agent",
        "icon": "$(plug)"
      },
      {
        "command": "jawataChat.newConversation",
        "title": "jawata chat: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "jawataChat.sendPrompt",
        "title": "jawata chat: Send Prompt"
      },
      {
        "command": "jawataChat.cancelTurn",
        "title": "jawata chat: Cancel Current Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "jawataChat.disconnectAgent",
        "title": "jawata chat: Disconnect Agent",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "jawataChat.openChat",
        "title": "jawata chat: Open Chat Panel"
      },
      {
        "command": "jawataChat.configureAgent",
        "title": "jawata chat: Configure Agent",
        "icon": "$(add)"
      },
      {
        "command": "jawataChat.showLog",
        "title": "jawata chat: Show Log"
      },
      {
        "command": "jawataChat.showTraffic",
        "title": "jawata chat: Show Protocol Traffic"
      },
      {
        "command": "jawataChat.setMode",
        "title": "jawata chat: Set Agent Mode"
      },
      {
        "command": "jawataChat.setModel",
        "title": "jawata chat: Set Agent Model"
      },
      {
        "command": "jawataChat.setAutonomy",
        "title": "jawata chat: Autocontinue on or off"
      },
      {
        "command": "jawataChat.askSide",
        "title": "jawata chat: Side question"
      },
      {
        "command": "jawataChat.closeSide",
        "title": "Close this side discussion and forget it. The main chat is not touched.",
        "icon": "$(close)"
      },
      {
        "command": "jawataChat.attachFile",
        "title": "jawata chat: Attach File to Prompt",
        "icon": "$(attach)"
      },
      {
        "command": "jawataChat.restartAgent",
        "title": "jawata chat: Restart Agent",
        "icon": "$(debug-restart)"
      },
      {
        "command": "jawataChat.openRecording",
        "title": "jawata chat: Open Session Recording"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jawataChat.closeSide",
          "when": "view == jawata-btw-view",
          "group": "navigation"
        },
        {
          "command": "jawataChat.newConversation",
          "when": "view =~ /^jawata-chat-view/",
          "group": "navigation@1"
        },
        {
          "command": "jawataChat.attachFile",
          "when": "view =~ /^jawata-chat-view/",
          "group": "navigation@2"
        },
        {
          "command": "jawataChat.cancelTurn",
          "when": "view =~ /^jawata-chat-view/ && jawataChat.turnInProgress",
          "group": "navigation@3"
        },
        {
          "command": "jawataChat.disconnectAgent",
          "when": "view =~ /^jawata-chat-view/",
          "group": "navigation@4"
        },
        {
          "command": "jawataChat.showLog",
          "when": "view =~ /^jawata-chat-view/"
        },
        {
          "command": "jawataChat.showTraffic",
          "when": "view =~ /^jawata-chat-view/"
        },
        {
          "command": "jawataChat.restartAgent",
          "when": "view =~ /^jawata-chat-view/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jawataChat.openChat",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      },
      {
        "command": "jawataChat.cancelTurn",
        "key": "escape",
        "when": "jawataChat.turnInProgress"
      },
      {
        "command": "jawataChat.setAutonomy",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "jawataChat.askSide",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "jawata chat",
      "properties": {
        "jawataChat.agent": {
          "type": "object",
          "description": "The one ACP agent this chat starts: command, args and env.",
          "default": {},
          "properties": {
            "command": {
              "type": "string",
              "description": "Program to start, e.g. npx"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Command-line arguments"
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Environment variables the agent program is started with, added to the editor's own."
            }
          }
        },
        "jawataChat.studio": {
          "type": "object",
          "scope": "machine",
          "description": "How the chat starts the jawata studio: the program to run, its arguments (the deploy writes --background, which shows no window) and handoffDir. When this window has folders open and handoffDir is set, the studio is started with --editor-folder for each folder, every time the window starts and whether or not the engine's service answers: the studio then finds or makes the jawata workspace that holds those folders (asking you only when a workspace matches only some of them, and then waiting for your answer at most 10 minutes) and tells this window which engine to use (its answer is waited for at most 330 seconds, because the studio gives its own engine 300 seconds to start; after that the setting's address is used with a warning); that engine's address and key are used by this window's programs only and are never written to a setting. Without handoffDir the studio is started only when the engine's service does not answer at the address in jawataChat.agent (its env JAWATA_URL). The studio's deploy to VS Code fills this in; do not set it by hand unless you know the studio's start command. Without it the studio is not started and the extension goes on as if it were not there. The studio is started detached, so it keeps running when the editor closes. It is a machine setting: a workspace cannot set it.",
          "default": {},
          "properties": {
            "command": {
              "type": "string",
              "description": "The studio program to start, as the deploy wrote it"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Its command-line arguments, as the deploy wrote them"
            },
            "handoffDir": {
              "type": "string",
              "description": "An absolute folder the studio writes its answer into: for the folders this window has open, the file <handoffDir>/<id>.json says which engine (address and key) serves them. The deploy writes it. Without it the window's folders are not handed to the studio and the engine address in jawataChat.agent is used as it is."
            }
          }
        },
        "jawataChat.logTraffic": {
          "type": "boolean",
          "default": false,
          "description": "Write every ACP message, in both directions, to the 'jawata chat traffic' output channel. The editor keeps an output channel in a log file in its own log folder, so with this on the conversation is on disk there; it is off as shipped."
        },
        "jawataChat.recordSessions": {
          "type": "boolean",
          "default": false,
          "description": "Keep each session as a JSON-lines recording (one message and its direction per line) in the extension's storage. Off as shipped: nothing is written to disk. The last 20 recordings are kept and older ones are deleted."
        },
        "jawataChat.placement": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "bottom",
            "center"
          ],
          "default": "center",
          "enumDescriptions": [
            "The left side bar (the activity bar)",
            "The right (secondary) side bar",
            "The bottom panel",
            "The editor area, as a tab in the middle"
          ],
          "description": "Where the chat opens: the left side bar, the right side bar, the bottom panel or the editor area. The chat is in one place at a time: opening it in another replaces the first."
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack",
    "build": "npm run compile",
    "watch": "webpack --watch",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --max-warnings 0",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test",
    "test:live": "npm run compile-tests && npm run compile && vscode-test --config .vscode-test.live.mjs",
    "test:live:controls": "npm run compile-tests && npm run compile && vscode-test --config .vscode-test.live-controls.mjs",
    "test:live:rows": "npm run compile-tests && npm run compile && vscode-test --config .vscode-test.live-rows.mjs",
    "test:visual": "npm run compile-tests && npm run compile && vscode-test --config .vscode-test.visual.mjs",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vscode:prepublish": "npm run package"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@jawata/acp-contract": "*",
    "@jawata/chat-core": "*",
    "@jawata/chat-view": "*"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
}
